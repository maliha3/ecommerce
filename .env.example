# Copy to .env for local work. On Render, set these as environment variables
# in the dashboard instead — never commit real values.

# --- Django -------------------------------------------------------------
SECRET_KEY=generate-a-new-one-see-README
DEBUG=True
ALLOWED_HOSTS=
TIME_ZONE=Asia/Dhaka

# --- Neon Postgres ------------------------------------------------------
# Dashboard -> Connection Details -> "Pooled connection".
# Leave BLANK locally to fall back to SQLite.
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# --- Cloudinary ---------------------------------------------------------
# Dashboard -> Product Environment Credentials -> "API environment variable".
# Leave BLANK locally to store uploads in ./media.
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_FOLDER=hellomalaysia

# --- Storefront ---------------------------------------------------------
SHOP_NAME=Hello Malaysia
SHOP_TAGLINE=Branded bags, shoes and jewellery, brought in from KL.
CURRENCY_SYMBOL=৳
SHOP_PHONE=01700-000000

# Shown on checkout for manual transfers. REPLACE THESE.
BKASH_NUMBER=01700-000000
NAGAD_NUMBER=01800-000000

DELIVERY_CHARGE_DHAKA=60
DELIVERY_CHARGE_OUTSIDE=120
